#!/usr/bin/env python3
import os
import re
import subprocess
import sys
import time

def get_active_window():
    try:
        out = subprocess.check_output(['xprop', '-root', '_NET_ACTIVE_WINDOW']).decode('utf-8', errors='ignore')
        m = re.search(r'0x[0-9a-fA-F]+', out)
        if m and m.group(0) != '0x0':
            return m.group(0)
    except Exception:
        pass
    return None

def get_nemo_window_id():
    try:
        out = subprocess.check_output(['wmctrl', '-l', '-x']).decode('utf-8', errors='ignore')
        for line in out.splitlines():
            if 'nemo-desktop.Nemo-desktop' in line:
                m = re.search(r'0x[0-9a-fA-F]+', line)
                if m:
                    return m.group(0)
    except Exception:
        pass
    return None

def ensure_nemo_desktop():
    # Verificar si el proceso corre
    res = subprocess.run(['pgrep', '-x', 'nemo-desktop'], stdout=subprocess.DEVNULL)
    if res.returncode != 0:
        subprocess.Popen(['nemo-desktop'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        time.sleep(1)

def main():
    quiet = '--quiet' in sys.argv or '-q' in sys.argv

    # 1. Guardar la ventana activa actual para no perder el foco
    prev_active = get_active_window()

    # 2. Asegurar que nemo-desktop esté corriendo
    ensure_nemo_desktop()

    # 3. Buscar el Window ID de nemo-desktop
    nemo_wid = get_nemo_window_id()

    # Si no aparece aún la ventana, esperar un breve momento o relanzar
    if not nemo_wid:
        time.sleep(0.5)
        nemo_wid = get_nemo_window_id()

    # 4. Forzar al gestor de ventanas Muffin a traer los iconos al frente vía EWMH
    if nemo_wid:
        subprocess.run(['wmctrl', '-i', '-a', nemo_wid])
    subprocess.run(['wmctrl', '-a', 'Escritorio'], stderr=subprocess.DEVNULL)
    subprocess.run(['wmctrl', '-a', 'Desktop'], stderr=subprocess.DEVNULL)

    # 5. Restaurar el foco a la ventana en la que estaba el usuario
    if prev_active and prev_active != nemo_wid:
        time.sleep(0.05)
        subprocess.run(['wmctrl', '-i', '-a', prev_active], stderr=subprocess.DEVNULL)

    # 6. Notificación visual
    if not quiet:
        try:
            subprocess.run([
                'notify-send',
                '-i', 'preferences-desktop-wallpaper',
                '-u', 'low',
                'Live Wallpaper',
                'Iconos del escritorio traídos al frente'
            ], check=False)
        except Exception:
            pass

if __name__ == '__main__':
    main()
